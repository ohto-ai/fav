{
  "name": "fav",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "收藏集网站：Cloudflare Pages + Pages Functions + D1",
  "scripts": {
    "dev": "wrangler pages dev .",
    "deploy": "wrangler pages deploy .",
    "db:init:local": "wrangler d1 execute fav --local --file=migrations/0001_init.sql",
    "db:init:remote": "wrangler d1 execute fav --remote --file=migrations/0001_init.sql",
    "seed:local": "wrangler d1 execute fav --local --file=migrations/seed.sql",
    "seed:remote": "wrangler d1 execute fav --remote --file=migrations/seed.sql",
    "seed:generate": "node scripts/generate-seed.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
